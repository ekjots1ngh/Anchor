# Anchor environment variables
#
# Copy to .env.local and fill in. .env* files are gitignored — secrets never
# get committed, and the key is only ever read server-side (see
# src/app/api/message/route.ts). It is never exposed to the browser.

# Used by /api/message to phrase the warm dashboard note (amber/red only).
# If unset, the dashboard falls back to its deterministic, template copy.
ANTHROPIC_API_KEY=

# Dev/stage demo panel. It always shows in `npm run dev`. Set this to "1" to
# also surface it on a deployed *preview* (e.g. a Vercel preview) for a stage
# demo. Leave unset in real production.
NEXT_PUBLIC_DEMO_MODE=

# Protects the /admin waitlist view and the `npm run waitlist` command.
# Open /admin?key=<this value> to see sign-ups. If unset, /admin shows nothing.
ADMIN_TOKEN=

# Durable waitlist storage. Connect a Vercel KV store (Storage → Create → KV)
# and these two are injected automatically — sign-ups persist to Redis and are
# retrievable from /admin anywhere. Without them, sign-ups go to a local file
# (./.data/waitlist.jsonl, dev only) and the server logs.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional EXTRA sink for waitlist submissions (in addition to the durable
# store above). If set, /api/waitlist also forwards each {email, role, note,
# createdAt} as JSON here — Google Sheet (Apps Script), Airtable, Formspree,
# a Slack/Discord webhook, Zapier/Make, etc.
WAITLIST_WEBHOOK_URL=
